# Node.js authoritative match host.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/server ./apps/server
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @iron/shared build \
 && pnpm --filter @iron/engine build \
 && pnpm --filter @iron/server build

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production PORT=8080
COPY --from=build /app /app
EXPOSE 8080
# tsx (not plain node): @iron/shared's package.json points "exports" at its raw
# src/index.ts (so dev/test resolve source directly), whose own internal `.js`
# specifiers (pointing at sibling `.ts` files) Node's native ESM resolver can't
# follow. tsx's loader handles that regardless of whether the entry point is
# compiled JS or TS, so it also works started from the tsc-built dist/index.js.
CMD ["/app/apps/server/node_modules/.bin/tsx", "apps/server/dist/index.js"]
