# Static client build served by Nginx with cross-origin isolation headers.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json tsconfig.json .prettierrc ./
COPY packages ./packages
COPY apps/client ./apps/client
COPY assets-src ./assets-src
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @iron/client build

FROM nginx:alpine AS run
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/client/dist /usr/share/nginx/html
EXPOSE 80
